{
  "manifest_version": 2,
  "name": "aBypass regional compatibility",
  "version": "1.0.1",
  "description": "Local, opt-in regional compatibility for Flow and Google Labs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "abypass-compat@app.abypass"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/*"],
      "js": ["core.js", "runtime.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
